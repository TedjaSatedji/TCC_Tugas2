# =============================================
# Environment Variables - Notes App Backend
# Rename file ini jadi .env sebelum dijalankan
# =============================================

# Server
PORT=3000

# MySQL / Cloud SQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=notes_db

# Untuk Cloud SQL / VM MySQL, ganti DB_HOST ke IP publik VM atau Cloud SQL instance IP
# DB_HOST=34.xxx.xxx.xxx
